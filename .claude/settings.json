{
  "permissions": {
    "deny": [
      "Bash(rm -rf .claude/commands/*)",
      "Bash(rm -rf .claude/docs/*)",
      "Bash(rm -rf .claude/scripts/*)",
      "Edit(.claude/commands/*)",
      "Edit(.claude/docs/ARD.md)",
      "Edit(.claude/docs/PRD.md)",
      "Edit(.claude/docs/ARCHITECTURE.md)",
      "Edit(.claude/scripts/*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint 2>&1 && npm run build 2>&1 && npm run test 2>&1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if grep -qE 'git\\s+push\\s+--force|git\\s+push\\s+-f\\b|git\\s+reset\\s+--hard|\\brm\\b|DROP\\s+TABLE|TRUNCATE'; then echo 'BLOCKED: 위험한 명령어가 차단되었습니다.' >&2; exit 2; fi"
          }
        ]
      }
    ]
  }
}
