# 서버 (Express)
PORT=3001

# listen 바인드 주소 — 기본 127.0.0.1(로컬 전용). 다른 PC에서 접속하려면 0.0.0.0 등으로 설정한다.
# loopback 밖 바인딩 + COLLECTION_TOKEN 미설정이면 수집 인제스트 HTTP 라우트가 503으로 비활성된다(fail-closed).
# HOST=0.0.0.0

# 수집 인제스트 토큰 — HOST로 LAN에 바인딩할 때는 사실상 필수(미설정이면 수집 HTTP 라우트 503 비활성).
# COLLECTION_TOKEN=change-me

# SPA 정적 루트 — 기본은 서버 모듈 기준 web/dist(npm run build 산출물). index.html이 없으면 서빙 비활성.
# 명시적으로 빈 값(SPA_DIR=)을 주면 강제 비활성(dev에서 Vite :5173만 쓸 때).
# SPA_DIR=/opt/news/web-dist

# 프론트엔드 (Vite) — API 베이스 URL
VITE_API_BASE=http://127.0.0.1:3001

# 미디어 검색 API 키 (서버 환경변수 — 클라이언트에 노출 금지)
# YouTube Data API v3 (영상 검색)
YOUTUBE_API_KEY=your-youtube-data-api-key
# Google Custom Search (이미지 검색)
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CSE_ID=your-google-custom-search-engine-id

# 배부 스풀 루트 (ADR-008 — 앱은 수신처별 하위 폴더에 기사 JSON을 쓰기만 하고, 발송은 외부 전송기가 한다)
# 미설정이면 배부가 비활성이다(파일을 쓰지 않는다).
# DIST_SPOOL_DIR=/var/spool/news-dist
