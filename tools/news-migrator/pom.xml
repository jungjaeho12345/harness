<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		phase 75 step2 — SQLite(news.db) → MySQL 8.0 마이그레이터.

		**왜 별도 모듈인가**(index.json decisions (2)(3)):
		- server-spring 의 NoSchemaSqlInMainSourcesTest.FORBIDDEN 이 main 소스·리소스에서 `flyway` 철자
		  자체를 금지한다. 그 게이트는 완화 대상이 아니라 설계 입력이므로 Flyway 는 이 모듈이 소유한다.
		- server-spring 을 멀티모듈 reactor 로 바꾸지 않는다. scripts/spring-contract.mjs 가
		  server-spring/target/*.jar 경로에 의존하므로 reactor 전환은 계약 하네스를 깬다.
		- 그래서 이 pom 은 부모가 없다(Spring Boot 부모 BOM 도 쓰지 않는다). 판본은 전부 명시 고정이고
		  값은 ~/.m2 캐시에 실제로 있는 것들이다(오프라인에서 죽지 않게).

		**Spring 을 넣지 않는다** — 이 도구는 CLI 한 프로세스이고 컨테이너·자동설정이 필요 없다.
	-->
	<groupId>harness</groupId>
	<artifactId>news-migrator</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>news-migrator</name>
	<description>news.db(SQLite) → MySQL 8.0 이관 도구 · Flyway 기반선 소유 (phase 75 / P2)</description>

	<properties>
		<maven.compiler.release>25</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<flyway.version>11.0.0</flyway.version>
		<junit.version>6.0.3</junit.version>
	</properties>

	<dependencies>
		<!-- 읽기 전용 소스(news.db)를 여는 드라이버. 판본은 server-spring 과 동일 — 두 모듈이 같은
		     SQLite 구현으로 읽어야 대조가 같은 의미를 갖는다. -->
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>3.47.2.0</version>
		</dependency>

		<!-- 대상 드라이버. 판본은 server-spring 이 step1 에서 고정한 것과 동일하다. -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<version>9.1.0</version>
		</dependency>

		<!-- MySQL 스키마의 정본(V1__baseline.sql)을 적용하는 도구. flyway-mysql 은 MySQL 방언 모듈이며
		     둘 다 있어야 MySQL 대상 마이그레이션이 동작한다(core 만으로는 방언이 없다). -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
			<version>${flyway.version}</version>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
			<version>${flyway.version}</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>news-migrator</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
			</plugin>
			<!--
				**shade 를 택한 이유**(maven-jar-plugin + 의존성 동봉 대신):
				이 도구는 계약 하네스(step7)와 런북(step8)이 `java -jar` 한 줄로 부른다 — 클래스패스를
				조립해 주는 셸이 없다. 그리고 결정적인 것은 **META-INF/services 병합**이다:
				JDBC 드라이버 등록(java.sql.Driver)과 Flyway 의 방언 확장(DatabaseType)이 전부
				서비스 파일로 발견되는데, 단순 동봉(assembly 의 jar-with-dependencies 포함)은 같은 이름의
				서비스 파일을 **덮어써서** 드라이버나 MySQL 방언이 조용히 사라진다. shade 의
				ServicesResourceTransformer 는 그것을 병합한다 — "조용한 실패"를 만들지 않는 쪽을 택했다.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>harness.newsmigrator.MigratorCli</mainClass>
								</transformer>
							</transformers>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
